# ── TubeForge environment variables ────────────────────────────────────────
# Everything here is OPTIONAL. Copy to .env only for local development.
# On Render, set these in the dashboard (or let render.yaml do it).

# SQLite database file (Render persistent disk: file:/data/db/custom.db)
DATABASE_URL=file:./db/custom.db

# Where rendered videos / audio / thumbnails are written
# (Render persistent disk: /data/media)
MEDIA_ROOT=./media

# Output resolution base: 1080 (default) = Shorts 1080x1920 / Long 1920x1080.
# 720 = Shorts 720x1280 / Long 1280x720 — ~56% less CPU+RAM, recommended on
# Render's free tier (512MB). Captions scale automatically.
# RENDER_SCALE=720

# ── Z.ai AI credentials (needed ONLY for scripts/SEO — glm-4.5-flash is FREE) ─
# Get a key at https://z.ai/manage-apikey/apikey-list, then either place a
# .z-ai-config file or (on Render/Docker) set ONE env var:
# ZAI_CONFIG_JSON={"baseUrl":"https://api.z.ai/api/paas/v4","apiKey":"your-key"}
#
# Scene images + thumbnails do NOT need any key or balance:
# they are generated FREE via Pollinations.ai by default.

# Optional model upgrades:
# ZAI_CHAT_MODEL=glm-4.5-flash   # glm-4.6 / glm-5.2 = paid, better quality

# ── Scene images ─────────────────────────────────────────────────────────────
# Default: 100% free Pollinations.ai (no key). Retry ladder flux → turbo,
# then paid Z.ai (if configured), then a gradient so rendering never dies.
# IMAGE_PROVIDER=auto            # auto | pollinations | zai | gradient
# IMAGE_FREE_MODEL=flux          # pin one Pollinations model (flux / turbo)

# ── Voiceover ──────────────────────────────────────────────────────────────
# Default: FREE no-key chain (Microsoft Edge neural voices → Google TTS).
# For premium voices, point at any OpenAI-style /audio/speech endpoint:
# TTS_API_URL=https://api.openai.com/v1/audio/speech
# TTS_API_KEY=sk-...
# TTS_MODEL=tts-1
# TTS_FREE_VOICE=en-US-ChristopherNeural   # override the default free voice

# ── Optional: pre-set YouTube OAuth credentials instead of the Settings UI.
# Leave unset and configure them in the dashboard (Settings → YouTube).
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Optional: explicit path to ffmpeg/ffprobe if not on PATH.
# Rarely needed — TubeForge bundles static ffmpeg/ffprobe binaries that are
# downloaded automatically during `bun install` / `npm install`.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Per-command ffmpeg timeout in ms (default 2,700,000 = 45 min).
# Render's free tier (0.1 CPU) encodes slowly — Shorts take 10-20 min.
# FFMPEG_TIMEOUT_MS=2700000
